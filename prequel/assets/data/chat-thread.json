{
  "before": [
    { "id": "m01", "who": "her", "time": "07/02 20:03", "text": "請問這個還在嗎?看到你貼的靖河站限定" },
    { "id": "m02", "who": "him", "time": "07/02 20:12", "text": "在啊,妳也是雋的粉絲?" },
    { "id": "m03", "who": "her", "time": "07/02 20:15", "text": "算是,我姐超愛他" },
    { "id": "m04", "who": "him", "time": "07/02 20:24", "text": "妳姐是不是也超愛雋？看妳打字口氣就知道家裡有人帶妳入坑哈哈", "tag": 1 },
    { "id": "m05", "who": "her", "time": "07/02 20:27", "text": "哈哈算是啦" },
    { "id": "m06", "who": "him", "time": "07/02 20:36", "text": "我這片是2019巡演的,靖河站真的很難找,妳知道場次很內行" },
    { "id": "m07", "who": "her", "time": "07/02 20:40", "text": "我記得那場是12月吧?" },
    { "id": "m08", "who": "him", "time": "07/02 20:49", "text": "是11月,妳記錯了,不過很多人都會搞混" },
    { "id": "m09", "who": "her", "time": "07/02 20:52", "text": "啊對齁,謝謝糾正" },
    { "id": "m10", "who": "him", "time": "07/02 21:01", "text": "我掛兩年了，問的人一堆，我一個都沒回。妳是第一個講得出場次的", "tag": 5 },
    { "id": "m11", "who": "her", "time": "07/10 21:40", "text": "還在嗎?我這幾天在存錢" },
    { "id": "m12", "who": "him", "time": "07/10 21:52", "text": "不用急,我不賣別人" },
    { "id": "m13", "who": "her", "time": "07/10 21:55", "text": "真的假的謝謝你!!" },
    { "id": "m14", "who": "him", "time": "07/10 22:04", "text": "妳還在唸書吧?錢自己留著,我又不趕時間" },
    { "id": "m15", "who": "her", "time": "07/18 19:10", "text": "我打工存到一半了" },
    { "id": "m16", "who": "him", "time": "07/18 19:21", "text": "這片還是別跟太多人講好，唱片圈很亂，被知道會有人來搶", "tag": 3 },
    { "id": "m17", "who": "her", "time": "07/18 19:24", "text": "好我不會亂講" },
    { "id": "m18", "who": "him", "time": "07/18 19:33", "text": "別叫我大哥啦，我們算同好", "tag": 6 },
    { "id": "m19", "who": "her", "time": "07/28 22:14", "text": "存夠了!!我們約時間好嗎" },
    { "id": "m20", "who": "him", "time": "07/28 22:25", "text": "這麼晚還在？妳家管很鬆喔，我媽以前十點就收手機", "tag": 2 },
    { "id": "m21", "who": "her", "time": "07/28 22:28", "text": "哈哈我爸媽比較不管" },
    { "id": "m22", "who": "him", "time": "07/28 22:39", "text": "妳同學也有在追嗎？有的話我可以幫忙留意", "tag": 4 },
    { "id": "m23", "who": "her", "time": "07/28 22:42", "text": "有一個,我再問問她" },
    { "id": "m24", "who": "him", "time": "08/05 21:03", "text": "先傳個學生證我看一下好了，免得又是收了東西就跑的", "tag": 9 },
    { "id": "m25", "who": "her", "time": "08/05 21:15", "text": "喔好,那我傳一下" },
    { "id": "m26", "who": "him", "time": "08/05 21:24", "text": "謝啦,這樣我也比較放心" },
    { "id": "m27", "who": "him", "time": "08/10 18:02", "text": "妳幾點下課？我看能不能配合妳", "tag": 10 },
    { "id": "m28", "who": "her", "time": "08/10 18:10", "text": "禮拜四3點半" },
    { "id": "m29", "who": "him", "time": "08/10 18:19", "text": "其實有人昨天出到兩萬，我先壓著沒回", "tag": 7 },
    { "id": "m30", "who": "her", "time": "08/10 18:22", "text": "真的假的!謝謝你留給我" },
    { "id": "m31", "who": "him", "time": "08/10 18:31", "text": "我這禮拜之後要去南部一陣子，回來不知道什麼時候", "tag": 8 },
    { "id": "m32", "who": "her", "time": "08/10 18:34", "text": "那我們約禮拜四好嗎?8/14" }
  ],
  "reorder": [
    { "id": "r1", "who": "him", "time": "08/10 18:43", "text": "禮拜四可以啊,妳下課直接來嗎?" },
    { "id": "r2", "who": "her", "time": "08/10 18:45", "text": "應該可以,大概4點左右?" },
    { "id": "r3", "who": "him", "time": "08/10 18:54", "text": "好啊那約在河西・文昌站見面", "edited": true },
    { "id": "r4", "who": "her", "time": "08/10 18:57", "text": "文昌站哪個出口比較好找?" },
    { "id": "r5", "who": "him", "time": "08/10 19:06", "text": "2號出口,出來有一間連鎖咖啡廳,很好認", "edited": true },
    { "id": "r6", "who": "her", "time": "08/10 19:08", "text": "好!那就這樣說定了" }
  ],
  "after": [
    { "id": "m33", "who": "him", "time": "08/13 17:20", "text": "抱歉,明天好像會塞車,我們約晚一點好不好,17:30左右?" },
    { "id": "m34", "who": "her", "time": "08/13 17:35", "text": "喔好啊沒問題!" },
    { "id": "m35", "who": "him", "time": "08/14 17:18", "text": "那家咖啡廳我剛看有點吵，旁邊有間比較好講，我帶妳過去", "tag": 11 },
    { "id": "m36", "who": "her", "time": "08/14 17:20", "text": "喔好啊" },
    { "id": "m37", "who": "him", "time": "08/14 17:30", "text": "我車停興安那邊，走過去五分鐘就好", "tag": 12 },
    { "id": "m38", "who": "her", "time": "08/14 17:32", "text": "好" }
  ]
}
